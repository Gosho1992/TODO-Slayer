# Optional but recommended: raises GitHub's limit from 60 to 5,000 requests/hour and enables monster ages (git blame).
# A fine-grained token with public-repo read access is enough.
GITHUB_TOKEN=
# Optional: funny AI-generated monster names and taunts. Without it, the game uses built-in names.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
